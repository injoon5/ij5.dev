{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ij5",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-08-01",
	// §11: `nodejs_compat` measurably increases cold start. Nothing here needs it.
	"compatibility_flags": [],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// §11: watch CPU time, not wall-clock. Wall-clock includes KV/D1 waits.
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "125d0978bef8444fad1c426fdeb8c8f6"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ij5",
			"database_id": "36fa7080-54d2-4f7a-b883-4386b5f76d27",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "ij5-assets"
		}
	],
	"vars": {
		// Origin allowlist for the binary upload endpoint (§5). Secrets live in
		// `wrangler secret put`, never here.
		"PUBLIC_ORIGIN": "https://ij5.dev",
		"ASSETS_ORIGIN": "https://assets.ij5.dev",
		// The largest part of a file upload, in MiB. A part is one request, so
		// it must fit the zone plan's request-body limit: 100 MB on Free/Pro
		// (90 here), 200 MB on Business (~190), up to 5 GB on Enterprise. The
		// file limit is 10,000 parts of this, up to R2's ~5 TiB (`src/lib/uploads.ts`).
		"UPLOAD_PART_MIB": "90"
	}
}
