{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ij5",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-08-01",

	// §11: `nodejs_compat` measurably increases cold start. Nothing here needs it.
	"compatibility_flags": [],

	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},

	// §11: watch CPU time, not wall-clock. Wall-clock includes KV/D1 waits.
	"observability": {
		"enabled": true
	},

	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "PLACEHOLDER_KV_ID"
		}
	],

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ij5",
			"database_id": "PLACEHOLDER_D1_ID",
			"migrations_dir": "migrations"
		}
	],

	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "ij5-assets"
		}
	],

	"vars": {
		// Origin allowlist for the binary upload endpoint (§5). Secrets live in
		// `wrangler secret put`, never here.
		"PUBLIC_ORIGIN": "https://ij5.dev",
		"ASSETS_ORIGIN": "https://assets.ij5.dev"
	}
}
