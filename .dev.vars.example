# Local values for `vite dev` and `wrangler dev`. Copy to `.dev.vars`, which is
# gitignored. In production these are `wrangler secret put`, never `vars`.
#
# Generate a set:
#
#   node -e "const c=require('crypto');const t=c.randomBytes(32).toString('base64url');
#   console.log('token (password manager, nowhere else):',t);
#   console.log('AUTH_HASH='+c.createHash('sha256').update(t).digest('base64'));
#   console.log('SESSION_SECRET='+c.randomBytes(32).toString('base64'));
#   console.log('SALT='+c.randomBytes(32).toString('base64'));"

# base64(SHA-256(token)). The token itself is never stored anywhere.
AUTH_HASH=
# Rotate this to revoke every session at once. There is no session table.
SESSION_SECRET=
# Visitor hashing. Rotating it resets today's unique counts and nothing else.
SALT=

# Live widgets. Every one is optional and the site runs with none of them set:
# a widget whose credential is missing is *disabled*, not broken. Nothing is
# scheduled, no request goes out, and the widget draws the fallback it declares.
#
#   github      works without a token; one only raises the rate limit
#   grass       needs GITHUB_TOKEN — the contribution calendar is GraphQL-only
#               and GitHub refuses anonymous GraphQL
#   weather     no key at all (Open-Meteo)
#   post        no key at all (a feed is a public URL)
#
# GITHUB_TOKEN=
